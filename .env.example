# ═══════════════════════════════════════════════════════════════
#  انسخ هذا الملف إلى .env واملأ القيم. لا تضف .env إلى git أبداً.
# ═══════════════════════════════════════════════════════════════

# ── MetaTrader 5 (مطلوب للتشغيل الحقيقي فقط) ──────────────────
GD_MT5_LOGIN=
GD_MT5_PASSWORD=
GD_MT5_SERVER=

# ── MetaApi.cloud (حساب MT5 تجريبي/حقيقي من أي نظام) ──────────
# احصل عليهما من لوحة app.metaapi.cloud بعد إضافة حسابك
GD_METAAPI_TOKEN=
GD_METAAPI_ACCOUNT_ID=

# ── إشعارات Telegram (اختياري) ────────────────────────────────
# أنشئ بوتاً عبر @BotFather ثم احصل على chat_id من @userinfobot
GD_TELEGRAM_TOKEN=
GD_TELEGRAM_CHAT_ID=

# ── تجاوز أي إعداد YAML بالصيغة GD_<SECTION>__<KEY> ───────────
# GD_BOT__DRY_RUN=true
# GD_BOT__FEED=mt5
# GD_RISK__RISK_PER_TRADE=0.01
# GD_NOTIFICATIONS__PROVIDER=telegram
