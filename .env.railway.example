# ═══════════════════════════════════════════════════════════════════
#  متغيرات Railway — انسخها في: Service → Variables → Raw Editor
#  (لا تضع أسراراً في الملفات؛ Railway يحقنها كمتغيرات بيئة)
# ═══════════════════════════════════════════════════════════════════

# ── الوضع: تجريبي إجباري على Railway ──────────────────────────────
# MetaTrader5 لا تعمل على Linux، لذا التنفيذ ورقي والبيانات حقيقية.
GD_BOT__DRY_RUN=true
GD_BOT__FEED=yahoo
GD_BOT__LIVE_SYMBOL=XAUUSD=X

# ── التخزين الدائم (يتطلب Volume مركّب على /data) ─────────────────
# بدون هذه المتغيرات تُمسح قاعدة الصفقات وحالة الأقفال مع كل إعادة نشر
GD_STORAGE__DATABASE=/data/trades.db
GD_STORAGE__LOG_FILE=/data/bot.log
GD_KILL_SWITCH__STATE_FILE=/data/kill_switch.json
GD_GOLD_DRAGON__PSYCHOLOGY_GATE__STATE_FILE=/data/psychology.json
GD_NEWS__CALENDAR_FILE=/data/news_calendar.json

# ── إيقاع الفحص (أطول من المحلي حفاظاً على حصة مزوّد البيانات) ────
GD_BOT__SCAN_INTERVAL_SECONDS=300
GD_BOT__POSITION_CHECK_SECONDS=300

# ── رصيد المحاكاة الورقية ─────────────────────────────────────────
GD_BROKER__PAPER_BALANCE=1000
GD_BROKER__PAPER_SPREAD=0.30

# ── إشعارات Telegram (موصى بها بشدة — عينك على البوت) ─────────────
GD_NOTIFICATIONS__PROVIDER=telegram
GD_TELEGRAM_TOKEN=
GD_TELEGRAM_CHAT_ID=

# ── اختياري: Twelve Data بدل Yahoo (أدق، يتطلب مفتاحاً مجانياً) ───
# GD_BOT__FEED=twelvedata
# GD_BOT__LIVE_SYMBOL=XAU/USD
# GD_TWELVEDATA_KEY=

# ── شبكة تحوّط Buy Stop/Sell Stop (استراتيجية ثانية، معطّلة افتراضياً) ─
# فعّلها لتشغيلها بجوار SMC على نفس الخدمة (أمر التشغيل الافتراضي الآن
# run-all) بحساب ورقي مستقل تماماً — راجع config/grid.yaml قبل التفعيل،
# كل حد حماية فيه إلزامي لا اختياري.
# GD_GRID__ENABLED=true
GD_GRID__RISK_STATE_FILE=/data/grid_risk_state.json
GD_GRID__KILL_SWITCH_STATE_FILE=/data/grid_kill_switch.json

# ── الترقية إلى حساب MT5 تجريبي حقيقي عبر MetaApi ─────────────
# شغّل أولاً: railway run python -m src.main metaapi
# ولا تفعّل هذه إلا بعد نجاح كل الفحوص
# GD_BOT__DRY_RUN=false
# GD_BOT__FEED=metaapi
# GD_BROKER__PROVIDER=metaapi
# GD_BROKER__METAAPI_REGION=new-york
# GD_METAAPI_TOKEN=
# GD_METAAPI_ACCOUNT_ID=

# ── اختياري: تخفيف شروط الدخول لرؤية إشارات أكثر أثناء التجربة ────
# لا تفعل هذا على حساب حقيقي — الشروط الصارمة هي الحماية نفسها
# GD_GOLD_DRAGON__MIN_ACS=6.5
# GD_GOLD_DRAGON__KILLZONE_ONLY=false
